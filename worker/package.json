{
  "name": "@studio/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "voice": "tsx src/voice.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "story": "tsx --disable-warning=ExperimentalWarning src/cli.ts",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/server.ts",
    "mix": "tsx --disable-warning=ExperimentalWarning src/mix-cli.ts"
  },
  "dependencies": {
    "@studio/project": "workspace:*",
    "@studio/schema": "workspace:*",
    "@studio/story": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
