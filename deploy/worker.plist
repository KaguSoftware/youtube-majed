<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the production worker (PLAN.md failure mode 4).

  Install: replace REPO below with the absolute repo path, then
    cp deploy/worker.plist ~/Library/LaunchAgents/com.youtube-majed.worker.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.youtube-majed.worker.plist

  KeepAlive restarts the worker if it dies; on restart it reclaims its own
  orphaned job at once (same worker id, host lock held). ExitTimeOut gives a
  `launchctl kickstart -k` or logout time to finish the current shot and
  release the job cleanly before launchd escalates to SIGKILL — and SIGKILL is
  survivable anyway, at the cost of the one shot in flight.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.youtube-majed.worker</string>
    <key>WorkingDirectory</key>
    <string>REPO</string>
    <key>ProgramArguments</key>
    <array>
        <string>REPO/.venv/bin/python</string>
        <string>-u</string>
        <string>-m</string>
        <string>pipeline.worker</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>REPO/work/worker.log</string>
    <key>StandardErrorPath</key>
    <string>REPO/work/worker.log</string>
</dict>
</plist>
