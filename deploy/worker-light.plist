<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the worker's light lane: research and script jobs, which
  run `claude -p`, and publish jobs, which upload to YouTube. None needs the
  GPU (PLAN.md sections 11 and 14). A separate process from
  the GPU worker so Claude never waits behind a render; it takes its own work
  root (work/light) and so its own host lock.

  Install: replace REPO with the absolute repo path and HOME with your home
  directory (claude is in HOME/.local/bin), then
    cp deploy/worker-light.plist ~/Library/LaunchAgents/com.youtube-majed.worker-light.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.youtube-majed.worker-light.plist

  Secrets come from ~/.config/youtube-majed/worker.env, shared with the GPU
  worker. `claude` must be signed in for the user the agent runs as.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.youtube-majed.worker-light</string>
    <key>WorkingDirectory</key>
    <string>REPO</string>
    <key>ProgramArguments</key>
    <array>
        <string>REPO/.venv/bin/python</string>
        <string>-u</string>
        <string>-m</string>
        <string>pipeline.worker</string>
        <string>--kinds</string>
        <string>research,script,publish</string>
        <string>--no-caffeinate</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>REPO/work/worker-light.log</string>
    <key>StandardErrorPath</key>
    <string>REPO/work/worker-light.log</string>
</dict>
</plist>
