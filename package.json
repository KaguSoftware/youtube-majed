{
  "name": "studio",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "pnpm --filter @studio/remotion studio",
    "validate": "pnpm --filter @studio/remotion validate",
    "render": "pnpm --filter @studio/remotion render",
    "render:preview": "pnpm --filter @studio/remotion render:preview",
    "typecheck": "pnpm -r typecheck",
    "voice": "pnpm --filter @studio/worker voice",
    "sync-check": "pnpm --filter @studio/remotion sync-check",
    "schemas": "pnpm --filter @studio/schema schemas",
    "test": "pnpm -r --if-present test",
    "story": "pnpm --silent --filter @studio/worker story",
    "worker": "pnpm --filter @studio/worker start",
    "app": "pnpm --filter @studio/app dev",
    "mix": "pnpm --silent --filter @studio/worker mix",
    "assets": "cd audio && uv run python -m studio_audio.assets",
    "render:project": "pnpm --filter @studio/remotion render:project"
  }
}
