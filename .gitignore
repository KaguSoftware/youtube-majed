# --- v2 studio ---
# project data, licensed media and renders stay on this machine
projects/*
!projects/.gitkeep
assets/sfx/*
!assets/sfx/.gitkeep
assets/music/*
!assets/music/.gitkeep
assets/voices/*
!assets/voices/.gitkeep
renders/
*.mp4
*.mov

# node
node_modules/
.pnpm-store/
dist/
.next*/
*.tsbuildinfo

# python
.venv/
venv/
__pycache__/
*.pyc

# secrets
.env*

# os / editor
.DS_Store
*.log

# voiced audio is copied into Remotion's public dir by `pnpm voice` / `pnpm render` (local only)
remotion/public/projects/

# python build metadata
*.egg-info/

# asset index, rebuilt from assets/sources.json by `pnpm assets index` (local only)
assets/index.sqlite*

# custom shot sources are staged here for a render or a check (remotion/src/custom/registry.ts)
remotion/src/custom/.staged/*
!remotion/src/custom/.staged/.gitkeep

# low-poly 3D sources (Mixamo FBX, their GLB conversions): licensed, never committed; listed with licences in assets/sources-3d.json
assets/3d/
